    <script type="text/javascript" language="javascript" class="init">

document.onkeydown = function (e) {
var theEvent = window.event || e;
var code = theEvent.keyCode || theEvent.which;
if (code == 13) {
$("#login_btn").click();
}
}

    function GetJsonData() {
        
        if ($("#username_input").val().indexOf("@")>0) {
            var json = {
                "username": $("#username_input").val(),
                "password": $("#password_input").val()
            };
        } else {
            var json = {
                "username": $("#username_input").val()+"@shie.com.cn",
                "password": $("#password_input").val()
            };
        }
        console.log("json is:"+json);

        return json;
    }

    $(document).ready(function () {
        $("#login_btn").click(function () {
            console.log("xxx"+window.location.protocol);
            let username=$("#username_input").val();
            let password=$("#password_input").val();
            let auth_url="/api/auth";

            //let auth_url=window.location.protocol+"//omp-api.shie.com.cn/auth";
            //let auth_url=window.location.protocol+"//omp-api.shie.com.cn:3000/auth";
            //let auth_url=window.location.protocol+"//omp.shie.com.cn/auth";
            if (username='') {
                console.log("username is null");
            }

            let json_data={ "username": username+"@shie.com.cn", "password": password};

            $.ajax({
                type: "POST",
                url: auth_url,
                contentType: "application/json; charset=utf-8",
                data: JSON.stringify(GetJsonData()),
                dataType: "json",
                success: function (data) {
                    console.log(JSON.stringify(data));
                    var result=JSON.stringify(data);
                    console.log(result);
                    console.log(data["success"]);
                    $.cookie("username",data['username']);
                    $.cookie("token", data['token']);
                    console.log($.cookie("username"));
                    console.log($.cookie("token"));
                    if (data["success"]==true) {


                        toastr.success(""+data['username']+"系统登录成功,页面调转中...！");
                        // get user information from domain
                        let usename=$("#username_input").val();
                        if (usename.indexOf("@")>0) {
                            usename=usename.substring(0,usename.indexOf("@"));
                        }

                        let displayname="xxx";
                        let mail="xxx@shie.com.cn";
                        let description="description";
                        $.ajax({
                                type: "POST",
                                url: "/api/finduser",
                                contentType: "application/json; charset=utf-8",
                                data: JSON.stringify({"username": usename }),
                                dataType: "json",
                                async: false,
                                success: function (data) {
                                    console.log(JSON.stringify(data));
                                    var result=JSON.stringify(data);
                                    console.log(result);
                                    console.log(data["success"]);
                                    if (data["success"]==true) {
                                        console.log("user exist");
                                        //console.log(JSON.stringify(data["message"]));
                                        //console.log(data["message"]);
                                        //console.log(JSON.parse(data["message"])[0]["dn"]);
                                        let message=data["message"];
                                        displayname=JSON.parse(data["message"])[0]["displayName"]
                                        mail=JSON.parse(data["message"])[0]["mail"]
                                        description=JSON.parse(data["message"])[0]["description"]
                                        console.log("displayname is:"+displayname);
                                        console.log("mail is:"+mail);
                                        console.log("description is:"+description);
                                    }
                                }
                        });
                        $.post("./login.jsp", {
                                    username: usename,
                                    displayname: displayname,
                                    mail: mail,
                                    description: description,
                                    token: data['token']
                                }, function (data, textStatus) {
                                    console.log(data.trim());
                                    if ("success"==data.trim()) {
                                        toastr.success("session creation succeed!"); 
                                        //$(location).attr('href', '/index.html');
                                        if(top !== self){            
                                            top.location.href = "/";
                                        } else window.location.href="/";
                                    }
                                    else toastr.warning("session creation failed!"+data.trim())
                                });

                        
                    } else {
                        toastr.warning("用户名或密码错误，系统登录失败！");
                    }
                },
                error: function (data) {
                    toastr.info("请求失败，请重试！")
                }
            });
            
        })

    })

